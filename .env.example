# ==============================================================================
# Magento 2 Production-Grade Application Environment Configuration
# Copy this file to .env and adjust variables for your target environment.
# NEVER commit the active .env file containing real secrets to version control.
# ==============================================================================

# Application Environment & Mode (developer, production, default)
MAGE_MODE=developer
MAGE_RUN_TYPE=store
MAGE_RUN_CODE=base

# Domain & URL Configuration
MAGENTO_HOST=localhost
MAGENTO_PORT=80
MAGENTO_BASE_URL=http://localhost/
MAGENTO_SECURE_BASE_URL=https://localhost/
MAGENTO_ADMIN_FRONTNAME=admin_secret

# Magento Admin Credentials (used for initial setup)
MAGENTO_ADMIN_FIRSTNAME=System
MAGENTO_ADMIN_LASTNAME=Administrator
MAGENTO_ADMIN_EMAIL=admin@example.com
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=AdminSecurePassword123!

# Localization & Store Configuration
MAGENTO_TIMEZONE=UTC
MAGENTO_CURRENCY=USD
MAGENTO_LANGUAGE=en_US
MAGENTO_USE_REWRITES=1

# Security & Encryption Key (leave empty for automatic generation during setup:install)
MAGENTO_CRYPT_KEY=32_char_hex_encryption_key_here

# MySQL / MariaDB Relational Database Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=magento
MYSQL_USER=magento
MYSQL_PASSWORD=MagentoDbSecurePass123!
MYSQL_ROOT_PASSWORD=RootDbSecurePass123!

# Redis Cache & Session Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SESSION_DB=0
REDIS_CACHE_DB=1
REDIS_PAGE_CACHE_DB=2

# OpenSearch Catalog Engine Configuration
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_PREFIX=magento2
OPENSEARCH_ENABLE_AUTH=0
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# RabbitMQ AMQP Message Broker Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# RabbitMQ Web UI Port on host (change if 15672 is already in use by another container)
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=magento
RABBITMQ_PASSWORD=RabbitSecurePass123!
RABBITMQ_VHOST=/magento

# Varnish Full Page Cache (FPC) Configuration
VARNISH_BACKEND_HOST=nginx
VARNISH_BACKEND_PORT=8080
VARNISH_PORT=80
VARNISH_CACHE_SIZE=512M

# Container User & Group ID Mapping (avoids file permission issues on Linux/macOS)
PUID=1000
PGID=1000

# PHP Runtime Resource Limits
PHP_MEMORY_LIMIT=2048M
PHP_MAX_EXECUTION_TIME=1800
UPLOAD_MAX_FILESIZE=64M
POST_MAX_SIZE=64M

# Xdebug Configuration (development only)
XDEBUG_ENABLED=0
XDEBUG_MODE=develop,debug
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
