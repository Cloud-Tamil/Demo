{
  "name": "company/magento2-application",
  "description": "Production-Grade Automated Magento 2 E-Commerce Application",
  "type": "project",
  "license": [
    "OSL-3.0",
    "AFL-3.0"
  ],
  "require": {
    "php": "~8.2.0 || ~8.3.0",
    "magento/product-community-edition": "2.4.7",
    "composer/composer": "^2.7",
    "colinmollenhour/credis": "^1.15",
    "aws/aws-sdk-php": "^3.300",
    "php-amqplib/php-amqplib": "^3.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.1",
    "phpstan/phpstan": "^1.11",
    "friendsofphp/php-cs-fixer": "^3.55"
  },
  "config": {
    "allow-plugins": {
      "magento/composer-root-update-plugin": true,
      "magento/inventory-composer-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist"
  },
  "autoload": {
    "psr-4": {
      "Magento\\Framework\\": "lib/internal/Magento/Framework/",
      "Company\\CustomModule\\": "app/code/Company/CustomModule/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
